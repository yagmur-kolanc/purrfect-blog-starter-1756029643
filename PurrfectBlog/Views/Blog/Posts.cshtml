@model IEnumerable<PurrfectBlog.Models.BlogPost>
@{
    ViewBag.Title = "All Posts";
}
<h2>All Posts</h2>
<hr />

<p>
    <a class="btn btn-primary" href="@Url.Action("CreatePost","Blog")">+ Create Post</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No posts yet.</div>
}
else
{
    <ul class="list-group">
        @foreach (var p in Model)
        {
            var text = p.Content ?? "";
            <li class="list-group-item">
                <h4 class="list-group-item-heading">
                    @Html.ActionLink(p.Title, "Post", "Blog", new { id = p.Id }, null)
                </h4>
                <p>
                    <small>@p.CreatedAt.ToString("yyyy-MM-dd")</small>
                    @if (!string.IsNullOrWhiteSpace(p.Category))
                    {
                        <span class="label label-default" style="margin-left:6px">@p.Category</span>
                    }
                </p>
                <p class="list-group-item-text">
                    @(text.Length > 160 ? text.Substring(0, 160) + "..." : text)
                </p>
                <p>
                    <a href="@Url.Action("Post","Blog", new { id = p.Id })">Read more →</a>
                </p>
            </li>
        }
    </ul>
}
